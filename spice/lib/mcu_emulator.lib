* =====================================================================
* mcu_emulator.lib
* ---------------------------------------------------------------------
* Универсальная электрическая модель пина микроконтроллера.
*
* Модель НЕ знает про периферию (ADC/TIM/USART/DAC). Описывает
* только вольт-амперное поведение пина в одном из режимов.
*
* Два subckt в файле:
*   MCU_PIN         — поведение одного пина (примитив)
*   STM32G071RBT6   — обёртка: 64 позиционных узла + 60 инстансов
*                     MCU_PIN, по одному на GPIO.
*
* Режимы MCU_PIN (параметр MODE):
*   0  HiZ           симметричный делитель RLEAK/RLEAK VDD↔VSS
*   1  ADC           10 МОм || 5 пФ на GND
*   2  вход pull-up  40 кОм к VDD
*   3  вход pull-dn  40 кОм к GND
*   4  выход high    VOH через ROUT
*   5  выход low     VOL через ROUT
*   6  PWM           VLO..VHI с FREQ и DUTY, через ROUT
*   ≠0..6            отрава: 999 В на пине
*
* Power-пины (Position 6 VBAT, 7 VREF+, 8 VDD, 9 VSS) — голые
* формальные узлы без MCU_PIN. Используются как аргументы vcc/gnd
* во всех инстансах MCU_PIN.
*
* Порядок узлов STM32G071RBT6 = Position 1..64 из XML
* STM32G071R(6-8-B)Tx.xml. Менять нельзя.
* =====================================================================


* ---------------------------------------------------------------------
* MCU_PIN — поведение одного пина
* ---------------------------------------------------------------------
.subckt MCU_PIN pin vcc gnd
+ PARAMS:
+ MODE=0
+ RPULL=40k
+ ROUT=40
+ RLEAK=1G
+ VOH=3.3
+ VOL=0
+ VHI=3.3
+ VLO=0
+ FREQ=1k
+ DUTY=0.5
+ RADC=10Meg
+ CADC=5p

* Валидность режима. 1 — рабочий, 0 — отрава.
.param _valid = (MODE >= 0 && MODE <= 6) ? 1 : 0

* Порог для PWM: доля периода с высоким уровнем = DUTY
.param _thr = cos(3.14159265358979 * DUTY)

* Резисторные ветки. В своём режиме — номинал, иначе — RLEAK
* (или полный обрыв, если резистор только в своём режиме).
.param _rpu  = (_valid == 1 && MODE == 2) ? RPULL : RLEAK
.param _rpd  = (_valid == 1 && MODE == 3) ? RPULL : RLEAK
.param _radc = (_valid == 1 && MODE == 1) ? RADC  : 1T
.param _cadc = (_valid == 1 && MODE == 1) ? CADC  : 0
.param _rout = (_valid == 1 && MODE >= 4 && MODE <= 6) ? ROUT : 1T

Rpu  pin vcc  {_rpu}
Rpd  pin gnd  {_rpd}
Radc pin gnd  {_radc}
Cadc pin gnd  {_cadc}
Rout pin _drv {_rout}

* Драйвер: VOH, VOL или PWM. В остальных режимах — 0 В на _drv,
* но это не важно, потому что Rout отключён.
Bdrv _drv gnd V = (MODE == 4) ? VOH : (MODE == 5) ? VOL : (MODE == 6) ? VLO + (VHI - VLO) * u(sin(6.28318530717959 * FREQ * time) - _thr) : 0

* Отрава при невалидном MODE: 999 В на пин через 1 Ом.
.param _rbad = _valid ? 1T : 1
.param _vbad = _valid ? 0  : 999
Rbad pin _bad {_rbad}
Bbad _bad gnd V = {_vbad}
.ends


* ---------------------------------------------------------------------
* STM32G071RBT6 — обёртка над 60 экземплярами MCU_PIN
* ---------------------------------------------------------------------
* Порядок узлов:
*   1 PC11,  2 PC12,  3 PC13,  4 PC14,  5 PC15,
*   6 VBAT,  7 VREF,  8 VDD,   9 VSS,
*  10 PF0,  11 PF1,  12 PF2,
*  13 PC0,  14 PC1,  15 PC2,  16 PC3,
*  17 PA0,  18 PA1,  19 PA2,  20 PA3,
*  21 PA4,  22 PA5,  23 PA6,  24 PA7,
*  25 PC4,  26 PC5,
*  27 PB0,  28 PB1,  29 PB2,
*  30 PB10, 31 PB11, 32 PB12, 33 PB13, 34 PB14, 35 PB15,
*  36 PA8,  37 PA9,
*  38 PC6,  39 PC7,
*  40 PD8,  41 PD9,
*  42 PA10, 43 PA11, 44 PA12, 45 PA13, 46 PA14, 47 PA15,
*  48 PC8,  49 PC9,
*  50 PD0,  51 PD1,  52 PD2,  53 PD3,  54 PD4,  55 PD5,  56 PD6,
*  57 PB3,  58 PB4,  59 PB5,  60 PB6,  61 PB7,  62 PB8,  63 PB9,
*  64 PC10
* ---------------------------------------------------------------------
.subckt STM32G071RBT6
+ PC11 PC12 PC13 PC14 PC15
+ VBAT VREF VDD  VSS
+ PF0  PF1  PF2
+ PC0  PC1  PC2  PC3
+ PA0  PA1  PA2  PA3  PA4  PA5  PA6  PA7
+ PC4  PC5
+ PB0  PB1  PB2
+ PB10 PB11 PB12 PB13 PB14 PB15
+ PA8  PA9
+ PC6  PC7
+ PD8  PD9
+ PA10 PA11 PA12 PA13 PA14 PA15
+ PC8  PC9
+ PD0  PD1  PD2  PD3  PD4  PD5  PD6
+ PB3  PB4  PB5  PB6  PB7  PB8  PB9
+ PC10
+ PARAMS:
+ MODE_PC11=0 MODE_PC12=0 MODE_PC13=0 MODE_PC14=0 MODE_PC15=0
+ MODE_PF0=0  MODE_PF1=0  MODE_PF2=0
+ MODE_PC0=0  MODE_PC1=0  MODE_PC2=0  MODE_PC3=0
+ MODE_PA0=0  MODE_PA1=0  MODE_PA2=0  MODE_PA3=0
+ MODE_PA4=0  MODE_PA5=0  MODE_PA6=0  MODE_PA7=0
+ MODE_PC4=0  MODE_PC5=0
+ MODE_PB0=0  MODE_PB1=0  MODE_PB2=0
+ MODE_PB10=0 MODE_PB11=0 MODE_PB12=0 MODE_PB13=0 MODE_PB14=0 MODE_PB15=0
+ MODE_PA8=0  MODE_PA9=0
+ MODE_PC6=0  MODE_PC7=0
+ MODE_PD8=0  MODE_PD9=0
+ MODE_PA10=0 MODE_PA11=0 MODE_PA12=0 MODE_PA13=0 MODE_PA14=0 MODE_PA15=0
+ MODE_PC8=0  MODE_PC9=0
+ MODE_PD0=0  MODE_PD1=0  MODE_PD2=0  MODE_PD3=0
+ MODE_PD4=0  MODE_PD5=0  MODE_PD6=0
+ MODE_PB3=0  MODE_PB4=0  MODE_PB5=0  MODE_PB6=0
+ MODE_PB7=0  MODE_PB8=0  MODE_PB9=0
+ MODE_PC10=0
+ FREQ_PC11=1k DUTY_PC11=0.5 FREQ_PC12=1k DUTY_PC12=0.5
+ FREQ_PC13=1k DUTY_PC13=0.5 FREQ_PC14=1k DUTY_PC14=0.5
+ FREQ_PC15=1k DUTY_PC15=0.5 FREQ_PF0=1k  DUTY_PF0=0.5
+ FREQ_PF1=1k  DUTY_PF1=0.5  FREQ_PF2=1k  DUTY_PF2=0.5
+ FREQ_PC0=1k  DUTY_PC0=0.5  FREQ_PC1=1k  DUTY_PC1=0.5
+ FREQ_PC2=1k  DUTY_PC2=0.5  FREQ_PC3=1k  DUTY_PC3=0.5
+ FREQ_PA0=1k  DUTY_PA0=0.5  FREQ_PA1=1k  DUTY_PA1=0.5
+ FREQ_PA2=1k  DUTY_PA2=0.5  FREQ_PA3=1k  DUTY_PA3=0.5
+ FREQ_PA4=1k  DUTY_PA4=0.5  FREQ_PA5=1k  DUTY_PA5=0.5
+ FREQ_PA6=1k  DUTY_PA6=0.5  FREQ_PA7=1k  DUTY_PA7=0.5
+ FREQ_PC4=1k  DUTY_PC4=0.5  FREQ_PC5=1k  DUTY_PC5=0.5
+ FREQ_PB0=1k  DUTY_PB0=0.5  FREQ_PB1=1k  DUTY_PB1=0.5
+ FREQ_PB2=1k  DUTY_PB2=0.5  FREQ_PB10=1k DUTY_PB10=0.5
+ FREQ_PB11=1k DUTY_PB11=0.5 FREQ_PB12=1k DUTY_PB12=0.5
+ FREQ_PB13=1k DUTY_PB13=0.5 FREQ_PB14=1k DUTY_PB14=0.5
+ FREQ_PB15=1k DUTY_PB15=0.5 FREQ_PA8=1k  DUTY_PA8=0.5
+ FREQ_PA9=1k  DUTY_PA9=0.5  FREQ_PC6=1k  DUTY_PC6=0.5
+ FREQ_PC7=1k  DUTY_PC7=0.5  FREQ_PD8=1k  DUTY_PD8=0.5
+ FREQ_PD9=1k  DUTY_PD9=0.5  FREQ_PA10=1k DUTY_PA10=0.5
+ FREQ_PA11=1k DUTY_PA11=0.5 FREQ_PA12=1k DUTY_PA12=0.5
+ FREQ_PA13=1k DUTY_PA13=0.5 FREQ_PA14=1k DUTY_PA14=0.5
+ FREQ_PA15=1k DUTY_PA15=0.5 FREQ_PC8=1k  DUTY_PC8=0.5
+ FREQ_PC9=1k  DUTY_PC9=0.5  FREQ_PD0=1k  DUTY_PD0=0.5
+ FREQ_PD1=1k  DUTY_PD1=0.5  FREQ_PD2=1k  DUTY_PD2=0.5
+ FREQ_PD3=1k  DUTY_PD3=0.5  FREQ_PD4=1k  DUTY_PD4=0.5
+ FREQ_PD5=1k  DUTY_PD5=0.5  FREQ_PD6=1k  DUTY_PD6=0.5
+ FREQ_PB3=1k  DUTY_PB3=0.5  FREQ_PB4=1k  DUTY_PB4=0.5
+ FREQ_PB5=1k  DUTY_PB5=0.5  FREQ_PB6=1k  DUTY_PB6=0.5
+ FREQ_PB7=1k  DUTY_PB7=0.5  FREQ_PB8=1k  DUTY_PB8=0.5
+ FREQ_PB9=1k  DUTY_PB9=0.5  FREQ_PC10=1k DUTY_PC10=0.5

* --- GPIO: 60 экземпляров MCU_PIN в порядке Position 1..64 ---
XPC11 PC11 VDD VSS MCU_PIN MODE={MODE_PC11} FREQ={FREQ_PC11} DUTY={DUTY_PC11}
XPC12 PC12 VDD VSS MCU_PIN MODE={MODE_PC12} FREQ={FREQ_PC12} DUTY={DUTY_PC12}
XPC13 PC13 VDD VSS MCU_PIN MODE={MODE_PC13} FREQ={FREQ_PC13} DUTY={DUTY_PC13}
XPC14 PC14 VDD VSS MCU_PIN MODE={MODE_PC14} FREQ={FREQ_PC14} DUTY={DUTY_PC14}
XPC15 PC15 VDD VSS MCU_PIN MODE={MODE_PC15} FREQ={FREQ_PC15} DUTY={DUTY_PC15}
XPF0  PF0  VDD VSS MCU_PIN MODE={MODE_PF0}  FREQ={FREQ_PF0}  DUTY={DUTY_PF0}
XPF1  PF1  VDD VSS MCU_PIN MODE={MODE_PF1}  FREQ={FREQ_PF1}  DUTY={DUTY_PF1}
XPF2  PF2  VDD VSS MCU_PIN MODE={MODE_PF2}  FREQ={FREQ_PF2}  DUTY={DUTY_PF2}
XPC0  PC0  VDD VSS MCU_PIN MODE={MODE_PC0}  FREQ={FREQ_PC0}  DUTY={DUTY_PC0}
XPC1  PC1  VDD VSS MCU_PIN MODE={MODE_PC1}  FREQ={FREQ_PC1}  DUTY={DUTY_PC1}
XPC2  PC2  VDD VSS MCU_PIN MODE={MODE_PC2}  FREQ={FREQ_PC2}  DUTY={DUTY_PC2}
XPC3  PC3  VDD VSS MCU_PIN MODE={MODE_PC3}  FREQ={FREQ_PC3}  DUTY={DUTY_PC3}
XPA0  PA0  VDD VSS MCU_PIN MODE={MODE_PA0}  FREQ={FREQ_PA0}  DUTY={DUTY_PA0}
XPA1  PA1  VDD VSS MCU_PIN MODE={MODE_PA1}  FREQ={FREQ_PA1}  DUTY={DUTY_PA1}
XPA2  PA2  VDD VSS MCU_PIN MODE={MODE_PA2}  FREQ={FREQ_PA2}  DUTY={DUTY_PA2}
XPA3  PA3  VDD VSS MCU_PIN MODE={MODE_PA3}  FREQ={FREQ_PA3}  DUTY={DUTY_PA3}
XPA4  PA4  VDD VSS MCU_PIN MODE={MODE_PA4}  FREQ={FREQ_PA4}  DUTY={DUTY_PA4}
XPA5  PA5  VDD VSS MCU_PIN MODE={MODE_PA5}  FREQ={FREQ_PA5}  DUTY={DUTY_PA5}
XPA6  PA6  VDD VSS MCU_PIN MODE={MODE_PA6}  FREQ={FREQ_PA6}  DUTY={DUTY_PA6}
XPA7  PA7  VDD VSS MCU_PIN MODE={MODE_PA7}  FREQ={FREQ_PA7}  DUTY={DUTY_PA7}
XPC4  PC4  VDD VSS MCU_PIN MODE={MODE_PC4}  FREQ={FREQ_PC4}  DUTY={DUTY_PC4}
XPC5  PC5  VDD VSS MCU_PIN MODE={MODE_PC5}  FREQ={FREQ_PC5}  DUTY={DUTY_PC5}
XPB0  PB0  VDD VSS MCU_PIN MODE={MODE_PB0}  FREQ={FREQ_PB0}  DUTY={DUTY_PB0}
XPB1  PB1  VDD VSS MCU_PIN MODE={MODE_PB1}  FREQ={FREQ_PB1}  DUTY={DUTY_PB1}
XPB2  PB2  VDD VSS MCU_PIN MODE={MODE_PB2}  FREQ={FREQ_PB2}  DUTY={DUTY_PB2}
XPB10 PB10 VDD VSS MCU_PIN MODE={MODE_PB10} FREQ={FREQ_PB10} DUTY={DUTY_PB10}
XPB11 PB11 VDD VSS MCU_PIN MODE={MODE_PB11} FREQ={FREQ_PB11} DUTY={DUTY_PB11}
XPB12 PB12 VDD VSS MCU_PIN MODE={MODE_PB12} FREQ={FREQ_PB12} DUTY={DUTY_PB12}
XPB13 PB13 VDD VSS MCU_PIN MODE={MODE_PB13} FREQ={FREQ_PB13} DUTY={DUTY_PB13}
XPB14 PB14 VDD VSS MCU_PIN MODE={MODE_PB14} FREQ={FREQ_PB14} DUTY={DUTY_PB14}
