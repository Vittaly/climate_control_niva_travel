XPC8  PC8  VDD VSS MCU_PIN MODE={MODE_PC8}  FREQ={FREQ_PC8}  DUTY={DUTY_PC8}
XPC9  PC9  VDD VSS MCU_PIN MODE={MODE_PC9}  FREQ={FREQ_PC9}  DUTY={DUTY_PC9}
XPD0  PD0  VDD VSS MCU_PIN MODE={MODE_PD0}  FREQ={FREQ_PD0}  DUTY={DUTY_PD0}
XPD1  PD1  VDD VSS MCU_PIN MODE={MODE_PD1}  FREQ={FREQ_PD1}  DUTY={DUTY_PD1}
