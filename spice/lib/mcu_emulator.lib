XPA10 PA10 VDD VSS MCU_PIN MODE={MODE_PA10} FREQ={FREQ_PA10} DUTY={DUTY_PA10}
XPA11 PA11 VDD VSS MCU_PIN MODE={MODE_PA11} FREQ={FREQ_PA11} DUTY={DUTY_PA11}
XPA12 PA12 VDD VSS MCU_PIN MODE={MODE_PA12} FREQ={FREQ_PA12} DUTY={DUTY_PA12}
XPA13 PA13 VDD VSS MCU_PIN MODE={MODE_PA13} FREQ={FREQ_PA13} DUTY={DUTY_PA13}
XPA14 PA14 VDD VSS MCU_PIN MODE={MODE_PA14} FREQ={FREQ_PA14} DUTY={DUTY_PA14}
