* stm32f103rc_helpers.lib
* ---------------------------------------------------------------------------
* STM32F103RCT6 — электрические характеристики кремния.
*
* Это РУКОПИСНЫЙ файл. Правится только при наличии измерений на реальном
* чипе или при переходе на другой кремний (F4, G0, ...). Всё, что
* зависит от конкретного проекта (какие пины задействованы, куда
* подключены, где ШИМ) — генерируется и лежит в spice/*_mcu.sub.
*
* Моделируем:
*   * выход push-pull: R_out последовательно, состояние 0/1 или ШИМ;
*   * вход digital: Rleak + Cin, опционально pull-up/pull-down;
*   * вход analog: Rleak + Cin (sample-and-hold не моделируется);
*   * склейка VDD/VSS через 0.01 Ω — убирает разницу потенциалов
*     между цифровым и аналоговым питанием в модели.
*
* Не моделируем:
*   * реальную вольт-амперную характеристику выходного каскада
*     (R_out линеен, без ограничения тока КЗ);
*   * входной ток утечки при перегреве;
*   * переходные процессы в схеме питания кристалла;
*   * programmable drive strength (2/10/50 MHz) — все пины как 40 Ω;
*   * slew rate и ringing на фронтах;
*   * ADC sample-and-hold (только импеданс входа).
*
* Точка отсчёта: STM32F103x8/xB datasheet, Table 55 (I/O static
* characteristics) и Table 24 (NRST/BOOT0 pull-up/down). Значения
* дефолтные, при расхождении с измерениями — менять здесь.
*
* Подключается через .INCLUDE из генерируемых spice/*_mcu.sub.
* ---------------------------------------------------------------------------


* ===========================================================================
* Параметры кремния
* ===========================================================================

.param R_OUT_STM32   = 40       ; Ω, series resistance push-pull (типовое)
.param R_LEAK_STM32  = 10Meg    ; Ω, вход / аналоговый вход (не течёт)
.param C_IN_STM32    = 5p       ; Ф, входная ёмкость пина (цифр./аналог)
.param R_PU_STM32    = 40k      ; Ω, встроенный pull-up к VDD
.param R_PD_STM32    = 40k      ; Ω, встроенный pull-down к VSS
.param R_PD_BOOT0    = 30k      ; Ω, BOOT0 — слабее обычного (по DS)
.param R_STUB_PWR    = 0.01     ; Ω, склейка VDD/VSS в общий узел


* ===========================================================================
* Выход push-pull, статический уровень (без B-источника)
*
*   STATE=0 → Rlo=40Ω, Rhi=1ТΩ  (пин = логический 0)
*   STATE=1 → Rlo=1ТΩ, Rhi=40Ω  (пин = логическая 1)
*
* Используется для всех выходных пинов сценария, у которых нет ШИМ.
* Дешевле PWM-варианта: не крутит тригонометрию на каждом шаге.
* ===========================================================================

.subckt _stm32_out pin vdd vss
+ PARAMS: STATE=0
Rhi pin vdd  R={ R_OUT_STM32 + (1-STATE)*1e12 }
Rlo pin vss  R={ R_OUT_STM32 +     STATE *1e12 }
.ends _stm32_out


* ===========================================================================
* Выход push-pull с ШИМ на борту
*
*   Bst генерирует прямоугольник 0..1 с заданными FREQ/DUTY/PHASE.
*   Формула: 0.5*(1 + tanh(k·(sin(2πft+φ) + cos(πD))))
*     где k=200 задаёт конечную крутизну фронта (~10 µs),
*     cos(πD) сдвигает порог так, что доля времени высокого
*     уровня = D.
*
*   D=0 → порог +1, почти всё время 0.
*   D=1 → порог −1, почти всё время 1.
*   D=0.5 → порог 0, ровно половина.
*
*   FREQ в Гц, DUTY 0..1, PHASE в радианах.
* ===========================================================================

.subckt _stm32_out_pwm pin vdd vss
+ PARAMS: FREQ=1k DUTY=0.5 PHASE=0
Bst state 0 V =
+   0.5 * (1 + tanh(200 * ( sin(2*PI*FREQ*time + PHASE)
+                         + cos(PI*DUTY) )))
Rhi pin vdd  R={ R_OUT_STM32 + (1-V(state))*1e12 }
Rlo pin vss  R={ R_OUT_STM32 +     V(state) *1e12 }
.ends _stm32_out_pwm


* ===========================================================================
* Выход open-drain
*
*   Только Rlo. Pull-up (внутренний через _stm32_od_pull или внешний)
*   подключается отдельно. Управление — STATE / PWM так же, как у
*   push-pull: STATE=0 → Rlo=1ТΩ (высокий Z), STATE=1 → Rlo=40Ω.
* ===========================================================================

.subckt _stm32_od pin vss
+ PARAMS: STATE=0
Rlo pin vss  R={ R_OUT_STM32 + (1-STATE)*1e12 }
.ends _stm32_od

.subckt _stm32_od_pwm pin vss
+ PARAMS: FREQ=1k DUTY=0.5 PHASE=0
Bst state 0 V =
+   0.5 * (1 + tanh(200 * ( sin(2*PI*FREQ*time + PHASE)
+                         + cos(PI*DUTY) )))
Rlo pin vss  R={ R_OUT_STM32 + (1-V(state))*1e12 }
.ends _stm32_od_pwm


* ===========================================================================
* Вход digital без подтяжки
*
*   Rleak=10MΩ к VSS — численный якорь для ngspice (без него
*   floating node → "no DC path to ground"). Cin=5пФ — входная
*   ёмкость. Никаких pull-up/pull-down: их физически нет, если
*   не включены явно. ADC и делители напряжения внешние.
* ===========================================================================

.subckt _stm32_in pin vss
Rleak pin vss R_LEAK_STM32
Cin   pin vss C_IN_STM32
.ends _stm32_in


* ===========================================================================
* Вход digital с внутренним pull-up (40 кΩ к VDD)
*
*   NRST, SWDIO, SWCLK после reset — pull-up включён.
* ===========================================================================

.subckt _stm32_in_pu pin vdd vss
Rleak pin vss R_LEAK_STM32
Cin   pin vss C_IN_STM32
Rpu   pin vdd R_PU_STM32
.ends _stm32_in_pu


* ===========================================================================
* Вход digital с внутренним pull-down (40 кΩ к VSS)
* ===========================================================================

.subckt _stm32_in_pd pin vss
Rleak pin vss R_LEAK_STM32
Cin   pin vss C_IN_STM32
Rpd   pin vss R_PD_STM32
.ends _stm32_in_pd


* ===========================================================================
* BOOT0 — pull-down слабее обычного (30 кΩ)
*
*   Отдельный шаблон, потому что по даташиту у BOOT0 своя
*   характеристика, и это единственный пин, где она отличается.
* ===========================================================================

.subckt _stm32_boot0 pin vss
Rleak pin vss R_LEAK_STM32
Cin   pin vss C_IN_STM32
Rpd   pin vss R_PD_BOOT0
.ends _stm32_boot0


* ===========================================================================
* Вход analog (ADC)
*
*   Тот же импеданс, что digital без pull: 10 МΩ + 5 пФ. Sample-and-hold
*   не моделируется — для медленных сигналов (NTC, потенциометры,
*   делители с RC порядка мс) внешний RC доминирует, и разница
*   невидима.
*
*   Если понадобится смоделировать реальное время заряда S/H
*   (например, для проверки быстрого датчика с RC ~10 µs):
*     * добавить ключ S1 pin Csh, управляемый CTRL_ADC,
*       с моделью .model SW_ADC SW(Ron=1k Roff=1G Vt=1.65 Vh=0)
*     * Csh=8p между Csh и vss
*   Здесь это не делаем: пока нет такого сценария.
* ===========================================================================

.subckt _stm32_ain pin vss
Rleak pin vss R_LEAK_STM32
Cin   pin vss C_IN_STM32
.ends _stm32_ain


* ===========================================================================
* Склейка питания
*
*   Не используется как субсхема — генератор создаёт эти резисторы
*   напрямую в .sub МК, потому что набор VDD/VSS-пинов
*   зависит от проекта. Здесь только значение параметра.
*
*   Пример сгенерированной склейки:
*     R_VDD_VBAT VCC_3V3  VDD_INT  0.01
*     R_VDD_VDDA VDDA_3V3 VDD_INT  0.01
*     R_VSS_VSSA GND      VSS_INT  0.01
*     ...
* ===========================================================================


* ===========================================================================
* Заметки по использованию
*
* 1. Файл подключается .INCLUDE в каждом сгенерированном
*    spice/<scenario>_mcu.sub. Сам по себе он не содержит
*    ни одного вызываемого субстракта верхнего уровня —
*    только шаблоны для инстансов из генератора.
*
* 2. UPPER-пины STM32F103RCT6, которые в модели остаются на 0
*    (не подключены к схеме в этом сценарии), инстанцируются
*    без шаблонов — генератор их просто не создаёт.
*
* 3. Если появится сценарий с несколькими одновременными ШИМ
*    (TIM1_CH1 + CH2 + CH3, например для 3-фазного моста),
*    каждый такой пин — отдельный _stm32_out_pwm с независимыми
*    FREQ/DUTY/PHASE. Никакой синхронизации между шаблонами нет:
*    если нужна синхронизация фронтов (dead-time, комплементарные
*    пары), параметры PHASE задаются так, чтобы совпадали.
*    Для взаимно-дополняющих сигналов: PHASE_1=0, PHASE_2=PI.
*
* 4. При смене частоты дискретизации .tran следите, чтобы шаг
*    был хотя бы на порядок меньше периода ШИМ: FREQ=100 Гц →
*    tstep ≤ 1 ms, FREQ=4 кГц → tstep ≤ 25 µs. Иначе ngspice
*    пропустит фронт.
*
* 5. tanh(200·x) даёт фронт ~10 µs. При FREQ > 10 кГц это уже
*    заметная доля периода (10%). Для FAN_PWM_CTL (≤ 100 Гц) —
*    не важно. Если понадобится 20 кГц ШИМ с фронтом <1 µs,
*    менять 200 → 1000 и следить за сходимостью (ngspice будет
*    дробить шаг на фронтах).
* ===========================================================================
